{
  "manifest_version": 3,
  "name": "{{NAME}} Downloads",
  "version": "1.0.1",
  "description": "Sends big downloads to {{NAME}}, which downloads them with several connections at once and never loses a file.",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "storage", "contextMenus", "alarms", "cookies", "webRequest", "scripting"],
  "host_permissions": {{HOSTS}},
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "{{NAME}} Downloads", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
