rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reports can only be ADDED, with a fixed list of fields and size limits. Nothing can be read, changed or
    // deleted from the app or from anyone holding the public web key; reading is done only with the owner's Google
    // access (see diagnostics/README.md).
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['install', 'app', 'version', 'os', 'cpu', 'lang', 'kind', 'settings', 'log', 'crash', 'at'])
        && request.resource.data.keys().hasAll(['install', 'app', 'version', 'kind', 'log', 'at'])
        && request.resource.data.app == 'pullwell'
        && request.resource.data.install is string && request.resource.data.install.size() <= 64
        && request.resource.data.version is string && request.resource.data.version.size() <= 32
        && request.resource.data.kind in ['log', 'crash']
        && request.resource.data.log is string && request.resource.data.log.size() <= 200000
        && request.resource.data.at is timestamp
        && (!('os' in request.resource.data) || request.resource.data.os.size() <= 64)
        && (!('cpu' in request.resource.data) || request.resource.data.cpu.size() <= 16)
        && (!('lang' in request.resource.data) || request.resource.data.lang.size() <= 16)
        && (!('crash' in request.resource.data) || request.resource.data.crash.size() <= 50000)
        && (!('settings' in request.resource.data) || request.resource.data.settings.size() <= 4000);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
